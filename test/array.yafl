{-
    Array Test
    Tests array creation, indexing, assignment, and length.
-}

fn start() -> none {
    println(>>--- Array Test ---<<);

    ~~ Zero init
    arr'int |arr_sugar|[4];
    println(>>Sugar:<<);
    println(|arr_sugar|);

    ~~ Simple Int Array
    arr'int |a| <- [1, 2, 3];
    println(|a|);
    print_len_here(|a|);

    ~~ Simple Str Array
    arr'str |b| <- [>>Hello<<, >>World<<];
    println(|b|);

    ~~ Empty Array (Zero Init)
    arr'int |c|;
    println(|c|);
    print_len_here(|c|);

    ~~ Nested Array
    arr'arr'int |d| <- [[1, 2], [3, 4]];
    println(|d|);

    ~~ Array Assignment
    |a|[0] <- 100;
    println(|a|);

    ~~ Sized init via multiplication syntax [val] * count
    arr'int |sized| <- [0] * 5;
    println(>>Sized:<<);
    println(|sized|);

    ~~ Matrix with multiplication syntax
    arr'arr'int |matrix| <- [[4, 5]] * 3;
    println(>>Matrix:<<);
    println(|matrix|);

    ~~ Independence check
    |matrix|[0][0] <- 99;
    println(>>After matrix[0][0] <- 99:<<);
    println(|matrix|[0]);
    println(|matrix|[1]);

    ~~ Allowed Array concatenation
    println(|arr_sugar| + |a|);

    ~~ Type error
    ~~ println(|arr_sugar| + |b|);
    ~~ println(|arr_sugar| + |matrix|);
}

fn print_len_here(arr'int: |a|) -> none {
    println(len(|a|));
}
