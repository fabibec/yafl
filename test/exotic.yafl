{-
    Exotic Test
    Test the more exotic number formats of yafl
-}

fn start() -> none {
    println(>>--- Exotic Numbers Test ---<<);

    ~~ Binary Integers
    int |bin| <- 2#1010; ~~ 10
    println(>>Binary 2#1010 (10): << + to_str(|bin|));

    ~~ Octal Integers
    int |oct| <- 8#755; ~~ 493
    println(>>Octal 8#755 (493): << + to_str(|oct|));

    ~~ Hex Integers (Implicit & Explicit)
    int |hex1| <- #FF; ~~ 255
    int |hex2| <- 16#A0; ~~ 160
    println(>>Hex #FF (255): << + to_str(|hex1|));
    println(>>Hex 16#A0 (160): << + to_str(|hex2|));

    ~~ Base 12 Integers
    int |dozen| <- 12#A0; ~~ 10 * 12 + 0 = 120
    println(>>Base12 12#A0 (120): << + to_str(|dozen|));

    ~~ Binary Floats
    float |bin_fl| <- 2#10.1; ~~ 2.5 (2 + 0.5)
    println(>>Binary Float 2#10.1 (2.5): << + to_str(|bin_fl|));

    ~~ Hex Floats
    float |hex_fl| <- 16#F.8; ~~ 15 + 8/16 = 15.5
    println(>>Hex Float 16#F.8 (15.5): << + to_str(|hex_fl|));

    ~~ Exponents
    float |exp_fl| <- 10#1.5^2; ~~ 1.5 * 10^2 = 150.0
    println(>>Exponent 10#1.5^2 (150.0): << + to_str(|exp_fl|));
}

