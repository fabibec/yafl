{-
    Basic Test
    Tests recursion, basic operations, and string concatenation.
-}

str |app name| <- >>Basic Test<<;

fn start() -> int {
    print(>>--- Basic Test ---<<);
    ops();
    recur(2);
    ret 0;
}

fn recur(int: |i|) -> none {
    if |i| < #5 {
        print(>>Going into recursion<<);
        print(|i|);
        |i|++;
        recur(|i|);
    }
    print(>>Moving out of recursion<<);
    print(|i|);
}

fn ops() -> none {
    bool |test 1| <- Yes;
    bool |test 2| <- Yes;
    bool |test 3| <- No;
    if |test 1| and |test 2| or |test 3| {
        print(>>This is correct!<<);
    }

    if |test 1| and |test 3| and |test 2| {
        print(>>You should not see this<<);
    }

    if |test 1| and ~|test 3| {
        print(>>This is correct!<<);
    }

    if -100 = -#64 {
        print(>>This is correct!<<);
    }

    if 100 ~= 2#1100100 {
       print(>>You should not see this too<<);
    }

    print(>>This program is called: << + |app name|);
}
