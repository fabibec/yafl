{-
    Basic Test
    Tests recursion, basic operations, and string concatenation.
-}

str |app name| <- >>Basic Test<<;

fn start() -> none {
    println(>>--- Basic Test ---<<);
    ops();
    recur(2);
}

fn recur(int: |i|) -> none {
    if |i| < #5 {
        println(>>Going into recursion<<);
        println(|i|);
        |i|++;
        recur(|i|);
    }
    println(>>Moving out of recursion<<);
    println(|i|);
}

fn ops() -> none {
    bool |test 1| <- Yes;
    bool |test 2| <- Yes;
    bool |test 3| <- No;
    if |test 1| and |test 2| or |test 3| {
        println(>>This is correct!<<);
    }

    if |test 1| and |test 3| and |test 2| {
        println(>>You should not see this<<);
    }

    if |test 1| and not |test 3| {
        println(>>This is correct!<<);
    }

    if -100 = -#64 {
        println(>>This is correct!<<);
    }

    if 100 ~= 2#1100100 {
       println(>>You should not see this too<<);
    }

    println(>>This program is called: << + |app name|);
}
