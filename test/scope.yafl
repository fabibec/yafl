{-
    Scope Test
    Tests scoping.
-}

fn start() -> none {
    float |a| <- 100.0;
    println(|a|);

    {
        float |a| <- 200.0;
        println(|a|);
        {
            str |a| <- >>Test<<;
            println(|a|);
        }
        println(|a|);
    }

    println(|a|);

    for int |a| in range(2) {
        {
            int |a| <- 400;
            println(|a|);
        }
        println(|a|);

    }

    println(|a|);
}
