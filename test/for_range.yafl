{-
    For Range Test
    Tests various forms of the range function and iterating over array literals.
-}

fn start() -> none {
    ~~ range(end)
    println(>>for i in range(5):<<);
    for int |i| in range(5) {
        println(|i|);
    }

    ~~ range(start, end)
    println(>>for i in range(2, 5):<<);
    for int |i| in range(2, 5) {
        println(|i|);
    }

    ~~ range(start, end, step)
    println(>>for i in range(0, 10, 2):<<);
    for int |i| in range(0, 10, 2) {
        println(|i|);
    }

    ~~ iterate over array literal
    println(>>for x in [10, 20, 30]:<<);
    for int |x| in [10, 20, 30] {
        println(|x|);
    }
}
