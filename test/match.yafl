{-
    Match Test
    Tests the match statement with integers, strings, fallthrough, and otherwise case.
-}

fn start() -> none {
    println(>>--- Match Test ---<<);

    int |x| <- 2;
    match |x| {
        case 1 -> { println(>>One<<); }
        otherwise -> { println(>>Other<<); }
        case 2 -> { println(>>Two<<); }
        case 3 -> { println(>>Three<<); }
    }

    match 2 {
        case 1 -> { println(>>One<<); }
        case 1+1 ->
        case 3 -> { println(>>Two or Three<<); }
        otherwise -> { println(>>Other<<); }
    }

    str |s| <- >>hello<<;
    match |s| {
        case >>hi<< -> { println(>>Hi there<<); }
        case >>hel<< + >>lo<< -> { println(>>Hello there<<); }
        otherwise -> { println(>>Unknown<<); }
    }

    match 99 {
        case 1 -> { println(>>1<<); }
        otherwise -> { println(>>Default hit<<); }
    }
}
