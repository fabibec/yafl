{-
    Slice Test
    Tests the slice() builtin for arrays and strings.
-}

fn start() -> none {
    arr'int |a| <- [0, 1, 2, 3, 4, 5];

    ~~ [1, 2, 3]
    arr'int |s1| <- slice(|a|, 1, 4);
    print(>>s1: <<);
    println(|s1|);

    ~~ [2, 3, 4, 5]
    arr'int |s2| <- slice(|a|, 2, 6);
    print(>>s2: <<);
    println(|s2|);

    ~~ [4, 5] (start=4, end=6)
    arr'int |s3| <- slice(|a|, -2, 6);
    print(>>s3: <<);
    println(|s3|);

    str |st| <- >>Hello World<<;
    str |ss1| <- slice(|st|, 0, 5); ~~ Hello
    println(>>ss1: << + |ss1|);

    str |ss2| <- slice(|st|, 6, 11); ~~ World
    println(>>ss2: << + |ss2|);

    ~~ Invalid / Edge case Slicing
    println(>>--- Invalid / Edge Cases ---<<);

    ~~ Start > End (Should return empty)
    arr'int |e1| <- slice(|a|, 4, 2);
    print(>>e1 (empty): <<);
    println(|e1|);

    ~~ Out of bounds (Should clip)
    arr'int |e2| <- slice(|a|, -10, 20);
    print(>>e2 (clipped): <<);
    println(|e2|);

    ~~ Start = End (Should return empty)
    str |e3| <- slice(|st|, 5, 5);
    println(>>e3 (empty): << + |e3|);
}
