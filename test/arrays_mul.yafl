fn start() -> int {
    ~~ Flat array
    arr'int |flat| <- [1, 2, 3];
    print(|flat|);

    ~~ Sized init via multiplication syntax [val] * count
    arr'int |sized| <- [0] * 5;
    print(>>Sized:<<);
    print(|sized|);

    ~~ Matrix with multiplication syntax
    arr'arr'int |matrix| <- [[0, 0]] * 3;
    print(>>Matrix:<<);
    print(|matrix|);

    ~~ Independence check
    |matrix|[0][0] <- 99;
    print(>>After matrix[0][0] <- 99:<<);
    print(|matrix|[0]);
    print(|matrix|[1]);

    ~~ Zero init
    arr'int |arr_sugar|[4];
    print(>>Sugar:<<);
    print(|arr_sugar|);

    ret 0;
}
