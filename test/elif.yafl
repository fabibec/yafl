{-
    Array Test
    Tests array creation, indexing, assignment, and length.
-}

fn start() -> none {
    int |x| <- 10;

    println(>>Testing elif...<<);

    if |x| < 5 {
        println(>>x < 5<<);
    } elif |x| < 15 {
        println(>>x < 15 (Correct)<<);
    } else {
        println(>>x >= 15<<);
    }

    int |y| <- 20;
    if |y| < 5 {
        println(>>y < 5<<);
    } elif |y| < 10 {
        println(>>y < 10<<);
    } elif |y| < 25 {
        println(>>y < 25 (Correct)<<);
    } else {
        println(>>y >= 25<<);
    }
}
