fn numbers() -> none {
    print(>>--- Numbers Test ---<<);
    int |a| <- 10;
    int |b| <- 3;
    print(>>Int Add: << + to<str>(|a| + |b|));
    print(>>Int Sub: << + to<str>(|a| - |b|));
    print(>>Int Mul: << + to<str>(|a| * |b|));
    print(>>Int Div: << + to<str>(|a| / |b|));
    print(>>Int Mod: << + to<str>(|a| % |b|));

    float |f1| <- 3.14;
    float |f2| <- 1.5;
    print(>>Float Add: << + to<str>(|f1| + |f2|));
    print(>>Float Sub: << + to<str>(|f1| - |f2|));
    print(>>Float Mul: << + to<str>(|f1| * |f2|));
    print(>>Float Div: << + to<str>(|f1| / |f2|));

    print(>>Mixed Add (int+float): << + to<str>(to<float>(|a|) + |f1|));
    print(>>--- End Numbers Test ---<<);
}

fn start() -> int {
    numbers();
    ret 0;
}
