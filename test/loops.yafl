{-
    Loops Test
    Tests for loops with ranges (positive and negative steps), strings, and loop variable scope.
-}

fn loops() -> none {
    int |i|;
    for |i| in range(5){
        println(>>Loop 1: Iteration << + to_str(|i|));
    }

    println(>>i is << + to_str(|i|) + >> after loop<<);

    for int |i| in range(0, -16#10, -2#1) {
        println(>>Negative: << + to_str(|i|));
    }

    println(>>i is still << + to_str(|i|));

    ~~ String Iteration
    for str |c| in >>Hello<< {
        println(|c|);
    }
}

fn start() -> int {
    println(>>--- Loops Test ---<<);
    loops();
    ret 0;
}
