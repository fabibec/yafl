fn loops() -> none {
    int |i|;
    for |i| in range(5){
        print(>>Loop 1: Iteration << + to<str>(|i|));
    }

    print(>>i is << + to<str>(|i|) + >> after loop<<);

    for int |i| in range(0, -2#10, -2#1) {
        print(>>Negative: << + to<str>(|i|));
    }

    print(>>i is still << + to<str>(|i|));
}

fn start() -> int {
    print(>>--- Loops Test ---<<);
    loops();
    ret 0;
}
