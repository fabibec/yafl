{

  "scopeName": "source.yafl",
  "name": "YAFL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.yafl",
          "match": "~~.*$"
        },
        {
          "name": "comment.block.yafl",
          "begin": "\\{\\-",
          "end": "\\-\\}"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.yafl",
          "begin": ">>",
          "end": "<<"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yafl",
          "match": "\\b(fn|ret|if|else|elif|for|in|while|match|case|otherwise|next|stop)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.yafl",
          "match": "\\b(int|str|float|bool|arr(\\')?|range\\'int|none)\\b"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.yafl",
          "match": "\\|[^|\n]+\\|"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.yafl",
          "begin": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "entity.name.function.yafl" }
          }
        },
        {
          "name": "support.function.yafl",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.yafl",
          "match": "(?:\\d{1,2}#|#)?[0-9A-Fa-f_]+(?:\\.[0-9A-Fa-f_]+)?(?:\\^[+-]?\\d+)?\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.yafl",
          "match": "<-\\+|<--|<-\\*|<-\\/|<-\\%|->|<-|\\+|\\-|\\*|\\/|%|~=|<=|>=|<|>|=|and|or|not"
        }
      ]
    }
  }
}
