{-
 This is a yafl language demo.
-}

int |global| <- #f;

fn start() -> none {

    ~~ Primitive types
    bool |bool| <- Yes or No;
    str |str| <- >>"String"<<;
    int |int| <- 8#77_777;
    float |float| <- 16#F.8^-1;

    ~~ Polymorphic operators
    arr'int |a1| <- [1, 2] + [3, 4];
    |a1| <-* 3;
    println(|a1|);

    str |s1| <- >>Hello<< + >> World<< * 5;
    println(|s1|);

    ~~ Ranges + Function Overloading
    range'int |r| <- range(1,6,2);
    str |s| <- >>Demo<<;
    iter(|r|);
    iter(|s|);

    ~~ Default Arguments
    url(>>www.oth-regensburg.de<<);
    url(>>www.google.de<<, 80, No);

    ~~ String functions
    str |haystack| <- >>Hello strangers<<;
    str |needle| <- >>strangers<<;
    int |start| <- contains(|haystack|, |needle|);
    str |sliced| <- slice(|haystack|, 0, |start| - 1);
    println(|sliced| + >> has len = << + to_str(len(|sliced|)));
}

fn url(str: |host|, int: |port| <- 10#443, bool: |secure| <- Yes) -> none {
    str |url|;
    if |secure| {
        |url| <-+ >>https://<<;
    } else {
        |url| <-+ >>http://<<;
    }
    |url| <-+ |host| + >>:<< + to_str(|port|);
    println(|url|);
}

fn iter(range'int: |it|) -> none {
    println(>>Iter for range<<);
    for int |i| in |it| {
        println(|i|);
    }
}

fn iter(str: |s|) -> none {
    println(>>Iter for str<<);
    for str |c| in |s| {
        int |ascii| <- to_int(|c|);
        println(>>Ascii: << + to_str(|ascii|) + >>, Str: << + |c|);
    }
}
