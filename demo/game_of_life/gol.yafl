~~ Globals
int |WIDTH| <- 30;
int |HEIGHT| <- 15;
bool |ALIVE| <- Yes;
bool |DEAD| <- No;

~~ Game loop
fn start() -> none {
    ~~ Hide cursor
    print(>>^x1B[?25l<<);

    println(>>Yafl Demo 1: Conway's Game of Life<<);
    arr'arr'bool |grid| <- init_field();
    arr'arr'bool |buffer| <- init_dead_arr();

    while Yes {
        print_grid(|grid|);
        update(|grid|, |buffer|);

        ~~ Swap
        arr'arr'bool |temp| <- |grid|;
        |grid| <- |buffer|;
        |buffer| <- |temp|;
    }
}

fn is_digit(str: |c|) -> bool {
    int |v| <- to_int(|c|);
    ret |v| >= to_int(>>0<<) and |v| <= to_int(>>9<<);
}

~~ Parse the int following a certain substring
fn parse_int_after(str: |line|, str: |substring|) -> int{
    ~~ Jump over substring
    int |idx| <- contains(|line|,|substring|);
    if |idx| = -1 { ret -1; }
    |idx| <-+ len(|substring|);

    ~~ Skip spaces
    while |line|[|idx|] = >> << { |idx|++; }

    ~~ Calculate int
    int |val|;
    while is_digit(|line|[|idx|]) {
        |val| <-* #A;
        |val| <-+ (to_int(|line|[|idx|]) - to_int(>>0<<));
        |idx|++;
    }
    ret |val|;
}


fn init_field() -> arr'arr'bool {
    arr'str |input args| <- args();
    arr'str |file content|;

    ~~ Parse .rle file if provided
    if len(|input args|) = 1 {
        |file content| <- read(|input args|[0]);
        if len(|file content|) = 0 {
            println(>>Error: Unable to read file: << + |input args|[0]);
            exit();
        }

        ~~ Skip comments
        int |line idx|;
        for str |line| in |file content| {
            if |line|[0] = >>#<< { |line idx|++; next; }
            stop;
        }

        ~~ Parse grid size
        str |first line| <- |file content|[|line idx|];
        int |pattern width| <- parse_int_after(|first line|, >>x = <<);
        int |pattern height| <- parse_int_after(|first line|, >>y = <<);

        if |pattern width| > |WIDTH| or |pattern height| > |HEIGHT| {
            println(>>Error: Grid size << + to_str(|WIDTH|) + >>x<< + to_str(|HEIGHT|) +
                >> to small for pattern of size << + to_str(|pattern width|) + >>x<< + to_str(|pattern height|));
            exit();
        }

        ~~ Calculate offset
        int |offset x| <- (|WIDTH| - |pattern width|) / 2;
        int |offset y| <- (|HEIGHT| - |pattern height|) / 2;

        arr'arr'bool |grid| <- init_dead_arr();
        println(>>Grid size: << + to_str(|WIDTH|) + >> x << + to_str(|HEIGHT|));
        |line idx|++;

        ~~ Parse pattern
        int |x|;
        int |y|;
        int |cnt|;
        for int |i| in range(|line idx|, len(|file content|)) {
            str |line| <- |file content|[|i|];

            for str |char| in |line| {
                match(|char|) {
                    case >>o<< -> {
                        ~~ live cell
                        if |cnt| = 0 { |cnt| <- 1; }
                        for int |j| in range (|cnt|) {
                            |grid|[|y| + |offset y|][|x| + |offset x|] <- |ALIVE|;
                            |x|++;
                        }
                        |cnt| <- 0;
                    }
                    case >>b<< -> {
                        ~~ dead cell - skip points
                        if |cnt| = 0 { |cnt| <- 1; }
                        |x| <-+ |cnt|;
                        |cnt| <- 0;
                    }
                    case >>$<< -> {
                        ~~ skip rows
                        if |cnt| = 0 { |cnt| <- 1; }
                        |y| <-+ |cnt|;
                        |x| <- 0;
                        |cnt| <- 0;
                    }
                    case >>!<< -> {
                        stop;
                    }
                    otherwise -> {
                        if is_digit(|char|) {
                            |cnt| <- |cnt| * 10 + (to_int(|char|) - to_int(>>0<<));
                        }
                    }
                }
            }
        }
        ret |grid|;
    } else {
        println(>>x = << + to_str(|WIDTH|) + >>, y = << + to_str(|HEIGHT|));
        println(>>No pattern file provided, creating random field!<<);
        arr'arr'bool |grid| <- init_dead_arr();
        init_random(|grid|);
        ret |grid|;
    }
}

~~ Init dead 2D-array
fn init_dead_arr() -> arr'arr'bool {
    arr'arr'bool |grid|[|HEIGHT|];
    for int |i| in range(0, |HEIGHT|) {
        |grid|[|i|] <- [|DEAD|] * |WIDTH|;
    }
    ret |grid|;
}

~~ Init random 2D-array
fn init_random(arr'arr'bool: |grid|) -> none {
    for int |y| in range(0, |HEIGHT|) {
        for int |x| in range(0, |WIDTH|) {
            if rng(4) = 0 {
                |grid|[|y|][|x|] <- |ALIVE|;
            }
        }
    }
}

~~ Check amount of alive surrounding neighbors
fn count_neighbors(arr'arr'bool: |grid|, int: |y|, int: |x|) -> int {
    int |count|;

    for int |dy| in range(-1, 2) {
        for int |dx| in range(-1, 2) {
            if |dy| = 0 and |dx| = 0 { next; }

            int |ny| <- |y| + |dy|;
            int |nx| <- |x| + |dx|;

            ~~ Bounds check
            if |ny| >= 0 and |ny| < |HEIGHT| and |nx| >= 0 and |nx| < |WIDTH| {
                if |grid|[|ny|][|nx|] = |ALIVE| {
                    |count|++;
                }
            }

        }
    }
    ret |count|;
}

~~ Gol update
fn update(arr'arr'bool: |grid|, arr'arr'bool: |next|) -> none {
    for int |y| in range(0, |HEIGHT|) {
        for int |x| in range(0, |WIDTH|) {
            ~~ Reset
            |next|[|y|][|x|] <- |DEAD|;

            int |neighbors| <- count_neighbors(|grid|, |y|, |x|);
            bool |cell| <- |grid|[|y|][|x|];

            if |cell| = |ALIVE| and (|neighbors| = 2 or |neighbors| = 3) {
                |next|[|y|][|x|] <- |ALIVE|;
            } elif |neighbors| = 3 {
                |next|[|y|][|x|] <- |ALIVE|;
            }
        }
    }
}

fn print_grid(arr'arr'bool: |grid|) -> none {
    print(>>+<< + (>>-<< * |WIDTH|) + >>+^n<<);
    for int |y| in range(0, |HEIGHT|) {
        print(>>|<<);
        for int |x| in range(0, |WIDTH|) {
            if |grid|[|y|][|x|] = |ALIVE| {
                print(>>#<<);
            } else {
                print(>> <<);
            }
        }
        print(>>|^n<<);
    }
    print(>>+<< + (>>-<< * |WIDTH|) + >>+^n<<);
    print(>>^x1B[<< + to_str(|HEIGHT| + 2) + >>A<<);
}
