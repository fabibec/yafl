fn start() -> none {
    arr'str |tests| <- [>>5[ab]<<, >>3[hello2[world]]<<, >>2[a3[b2[cd]]]<<, >>2[3[A2[B1[C]]]D]<<];
    arr'str |expected| <- [>>ababababab<<, >>helloworldworldhelloworldworldhelloworldworld<<,
        >>abcdcdbcdcdbcdcdabcdcdbcdcdbcdcd<<, >>ABCBCABCBCABCBCDABCBCABCBCABCBCD<<];

    println(>>Yafl Demo 2: Run Length Decoder<<);

    str |res|;
    int |idx|;
    for str |t| in |tests| {
        |res| <- decode(|t|);
        print(>>Test << + |t| + >> -> <<);
        print(|res|);
        if(|res| = |expected|[|idx|]){ println(>> [Passed]<<); } else {
            println(>> [Failed]<<);
            println(>>Expected: << + |expected|[|idx|]);
            println(>>Got:      << + |res|);
        }
        |idx|++;
    }
    str |inpt| <- input_str(>>Provide a string: <<);
    println(>>Decoded: << + decode(|inpt|));
}

fn is_digit(str: |chr|) -> bool {
    if(len(|chr|) ~= 1){ ret No; }
    int |ascii val| <- to_int(|chr|);
    if(|ascii val| >= to_int(>>0<<) and |ascii val| <= to_int(>>9<<)){ ret Yes; }
    ret No;
}


~~ Wrapper
int |idx|;
fn decode(str: |s|) -> str {
    |idx| <- 0;
    ret decode_rec(|s|);
}

fn decode_rec(str: |s|) -> str {
    str |result|;

    while (len(|s|) > |idx|){
        str |chr| <- |s|[|idx|];

        if(is_digit(|chr|)) {
            ~~ Decode number (arbitrary length)
            int |num|;
            while(|idx| < len(|s|) and is_digit(|s|[|idx|])){
                |num| <- |num| * #A + (to_int(|s|[|idx|]) - to_int(>>0<<));
                |idx|++;
            }

            ~~ Recursive call + Skip [
            |idx|++;
            str |substr| <- decode_rec(|s|);

            ~~ Repeat substring |num| times
            |result| <-+ |substr| * |num|;

        } elif (|chr| = >>]<<) {
            |idx|++;
            ret |result|;
        } else {
            |result| <-+ |chr|;
            |idx|++;
        }
    }
    ret |result|;
}
