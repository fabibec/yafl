fn square(int : |x|) -> int {
    ret |x| * |x|;
}

fn start() -> int {
    int |limit| <- #5;
    print(>>Running Loop up to %d...\n<<, |limit|);

    for int |i| in range(#1, #6, #1) {

        ~~ Call the function
        int |res| <- square(|i|);

        ~~ 4. If/Else Logic
        if (|res| > #10) {
            print(>>Big Number: %d squared is %d\n<<, |i|, |res|);
        } else {
            print(>>Small Number: %d squared is %d\n<<, |i|, |res|);
        }
    }

    print(>>Done!\n<<);
    return #0;
}
